<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.admin.base.module.support.file.dao.FileDao">


    <!-- 分页查询 -->
    <select id="queryPage" resultType="net.admin.base.module.support.file.domain.vo.FileVO">
        SELECT
        *
        FROM t_file
        <where>
            <!--文件夹类型-->
            <if test="queryForm.folderType != null">
                AND t_file.folder_type = #{queryForm.folderType}
            </if>
            <!--文件名词-->
            <if test="queryForm.fileName != null and queryForm.fileName != ''">
                AND t_file.file_name LIKE '%' || replace(replace(replace(#{queryForm.fileName}, '\', '\\'), '%', '\%'), '_', '\_') || '%'
            </if>
            <!--文件Key-->
            <if test="queryForm.fileKey != null and queryForm.fileKey != ''">
                AND t_file.file_key LIKE '%' || replace(replace(replace(#{queryForm.fileKey}, '\', '\\'), '%', '\%'), '_', '\_') || '%'
            </if>
            <!--文件类型-->
            <if test="queryForm.fileType != null">
                AND t_file.file_type = #{queryForm.fileType}
            </if>
            <!--创建人-->
            <if test="queryForm.creatorName != null and queryForm.creatorName != ''">
                AND t_file.creator_name LIKE '%' || replace(replace(replace(#{queryForm.creatorName}, '\', '\\'), '%', '\%'), '_', '\_') || '%'
            </if>
            <!--创建时间-->
            <if test="queryForm.createTimeBegin != null">
                AND t_file.create_time &gt;= CAST(#{queryForm.createTimeBegin} AS date)
            </if>
            <if test="queryForm.createTimeEnd != null">
                AND t_file.create_time &lt; CAST(#{queryForm.createTimeEnd} AS date) + INTERVAL '1 day'
            </if>
        </where>
        <if test="queryForm.sortItemList == null or queryForm.sortItemList.size == 0">
            ORDER BY t_file.create_time DESC
        </if>
    </select>

    <select id="getByFileKey" resultType="net.admin.base.module.support.file.domain.vo.FileVO">
        SELECT * FROM t_file where file_key = #{fileKey}
    </select>


    <select id="selectByFileKeyList" resultType="net.admin.base.module.support.file.domain.vo.FileVO">
        select * from t_file where file_key in
        <foreach collection="fileKeyList" open="(" close=")" separator="," item="item">
            #{item}
        </foreach>
    </select>

</mapper>